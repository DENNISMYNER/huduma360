# ==== Server ====
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ==== Database ====
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/huduma360"

# ==== Auth ====
# Use long, random, unique secrets in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=h360_token

# ==== Payments ====
# "mock" works out of the box. Switch to "mpesa" once you have real Daraja credentials.
PAYMENT_PROVIDER=mock
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# ==== Identity verification (mock external gov API) ====
IDENTITY_PROVIDER=mock

# ==== Rate limiting ====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
